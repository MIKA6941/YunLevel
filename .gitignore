# ============================================================
#  YunLevel .gitignore
#  原则：仓库只装「源码 + 文档 + 构建定义」
#        运行数据 / 编译产物 / 会话凭证 / 本地备份 一律排除
# ============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 编译产物（Dockerfile 内部会用 Linux g++ 重新编译）----------
native/build/
native-hx/build/
bin/
*.exe
*.o
*.obj
*.a
*.lib
*.dll
*.so

# ---------- 运行期数据（学生状态、曲线、评分记录、上传方案）----------
# 含 data/classes.json、state/、history/、submissions/、hx-*/、score_records.jsonl
data/
*.bin
*.bin.tmp

# ---------- 会话凭证（严重隐私风险，绝不能进仓库）----------
*.cookies
cookies.txt
teacher.txt
student.txt

# ---------- 测试数据目录（smoke / round01 / teacher 自建）----------
.test-data-*/
.test-data-*

# ---------- 临时文件与调试截图 ----------
.tmp-*
*.tmp
*.bak
*.swp
*~

# ---------- 本地备份与分享包（会完整复制一份源码）----------
Share/
backups/
*.tar.gz
*.zip

# ---------- 日志 ----------
*.log
npm-debug.log*
yarn-error.log*

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
docker-compose.override.yml
*.pem
*.key
*.p12

# ---------- 操作系统 / 编辑器 ----------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.iml
.vs/
*.user
*.suo

# ---------- 历史遗留 ----------
*.orig
*.rej
